model MailLog {
  id          String   @id @default(cuid())
  zeitpunkt   DateTime @default(now())
  an          String
  betreff     String
  text        String
  anhangName  String?
  status      String // TEST, GESENDET, FEHLER
  fehler      String?
  referenzTyp String?
  referenzId  String?
}

model PortalToken {
  id        String   @id @default(cuid())
  personId  String
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  gultigBis DateTime
  verwendetAm DateTime?
}

// ---------------------------------------------------------------- Wissensbot (nur Systemadmin)

model WissenDokument {
  id         String   @id @default(cuid())
  titel      String
  quelle     String?
  kategorie  String   @default("Firmenwissen") // Arbeitsrecht, Kalkulation, Firmenwissen, Vorlagen
