// ---------------------------------------------------------------- Gegenseitige Bewertung & Matching

/// Mitarbeiter bewertet Kunden/Einsatz (intern erfasst oder über das Mitarbeiter-Portal)
model KundenBewertung {
  id         String   @id @default(cuid())
  kundeId    String
  kunde      Kunde    @relation(fields: [kundeId], references: [id], onDelete: Cascade)
  personId   String
  person     Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  einsatzId  String?
  datum      DateTime @default(now())
  sterne     Int
  kommentar  String?
  wiederArbeiten Boolean @default(true) // würde dort wieder arbeiten
  merkmale   String[] @default([])
  quelle     String   @default("INTERN") // INTERN | PORTAL
}

/// Bewertungsanfrage an den Kunden (Link per E-Mail) – Kunde bewertet Mitarbeiter
model BewertungsAnfrage {
  id         String   @id @default(cuid())
  kundeId    String
  kunde      Kunde    @relation(fields: [kundeId], references: [id], onDelete: Cascade)
  personId   String
  person     Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  einsatzId  String?
  tokenHash  String   @unique
  an         String
  gultigBis  DateTime
  erledigtAm DateTime?
  erstelltAm DateTime @default(now())
}

/// Wochenraster der Einsatzplanung: X = arbeitet, K = krank, U = Urlaub, F = frei/kein Einsatz
model Wochenstatus {
  id        String @id @default(cuid())
  personId  String
  person    Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  jahr      Int
  kw        Int
  status    String // X | K | U | F (Wochenstatus = vorherrschender Tagesstatus)
  tage      String? // 7 Zeichen Mo–So: X arbeitet, K krank, U Urlaub, Z Zeitausgleich, F frei/kein Einsatz, - leer
  einsatzId String?
  notiz     String?
  @@unique([personId, jahr, kw])
  @@index([jahr, kw])
}

model Geocode {
  key   String @id // normalisierte Adresse
  lat   Float
  lon   Float
  quelle String @default("nominatim")
  erstelltAm DateTime @default(now())
}

/// Werdegang / Berufserfahrung – erscheint im Kundenprofil (Zeitraum, Firma, Tätigkeit, Notiz)
model Berufserfahrung {
  id          String @id @default(cuid())
  personId    String
  person      Person @relation(fields: [personId], references: [id], onDelete: Cascade)
  reihenfolge Int    @default(0)
  zeitraum    String
  firma       String
  taetigkeit  String
  notiz       String?
}


// ---------------------------------------------------------------- v2.1: Übernahme, Sperren, Kundenportal

/// Übernahme (Abwerbung) einer überlassenen Arbeitskraft durch den Beschäftiger – Aufwandsersatz lt. AGB Punkt 6:
/// 30 % des Bruttojahresentgelts, je vollem Überlassungsmonat −1/12, mindestens 2.500 €, nach 12 Monaten frei.
model Uebernahme {
  id             String   @id @default(cuid())
  kostenstelleId String
  kostenstelle   Kostenstelle @relation(fields: [kostenstelleId], references: [id])
  kundeId        String
  kunde          Kunde    @relation(fields: [kundeId], references: [id], onDelete: Cascade)
  personId       String
  person         Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  einsatzId      String?
  gemeldetAm     DateTime @default(now())
  uebernahmeAm   DateTime
  bruttojahresentgelt Float
  monateUeberlassen   Int   @default(0)
  prozent        Float    @default(0.30)
  mindesthonorar Float    @default(2500)
  honorar        Float
  status         String   @default("OFFEN") // OFFEN | VERRECHNET | VERZICHTET
  rechnungId     String?
  notiz          String?
  erstelltAm     DateTime @default(now())

  @@index([kundeId])
  @@index([personId])
}

/// Katalog der Sperrgründe – einheitlich statt Freitext
model Sperrgrund {
  id           String  @id @default(cuid())
  code         String  @unique
  bezeichnung  String
  sperrtEinsatz Boolean @default(true)
  sensibel     Boolean @default(false)
  reihenfolge  Int     @default(0)
  aktiv        Boolean @default(true)
  sperren      Sperre[]
}

/// Sperre eines Mitarbeiters – generell oder nur bei einem bestimmten Kunden
model Sperre {
  id         String   @id @default(cuid())
  personId   String
  person     Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  kundeId    String?  // null = generelle Sperre
  kunde      Kunde?   @relation(fields: [kundeId], references: [id], onDelete: Cascade)
  grundId    String?
  grund      Sperrgrund? @relation(fields: [grundId], references: [id])
  ab         DateTime @default(now())
  bis        DateTime?
  notiz      String?
  erfasstVon String?
  erstelltAm DateTime @default(now())

  @@index([personId])
  @@index([kundeId])
}

/// Kundenportal light: Link an den Beschäftiger für Stundenfreigabe und Bewertung
model KundenPortalToken {
  id          String   @id @default(cuid())
  kundeId     String
  kunde       Kunde    @relation(fields: [kundeId], references: [id], onDelete: Cascade)
  tokenHash   String   @unique
  an          String
  name        String?
  zweck       String   @default("STUNDEN") // STUNDEN | BEWERTUNG | BEIDES
  jahr        Int?
  kw          Int?
  gultigBis   DateTime
  verwendetAm DateTime?
  erstelltAm  DateTime @default(now())

  @@index([kundeId])
}


/// Web-Push-Abo der Mitarbeiter-App (ein Eintrag je Gerät/Browser)
model PushAbo {
  id         String   @id @default(cuid())
  personId   String
  person     Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  endpoint   String   @unique
  p256dh     String
  auth       String
  geraet     String?
  erstelltAm DateTime @default(now())
  zuletztOk  DateTime?
  fehler     Int      @default(0)

  @@index([personId])
}

/// Zähler gegen Massenanfragen: je Schlüssel (z. B. "appcode:<personId>") und Zeitfenster eine Zeile
model Zugriffszaehler {
  id         String   @id @default(cuid())
  schluessel String
  fenster    DateTime
  anzahl     Int      @default(0)
  erstelltAm DateTime @default(now())

  @@unique([schluessel, fenster])
  @@index([fenster])
}

/// Was im Hintergrund schiefgeht. Ohne diese Tabelle steht ein Fehler nur im Container-Log, und
/// dorthin sieht im Alltag niemand – ein kaputter Mailversand fiele erst auf, wenn wochenlang keine
/// Stundenzettel mehr kommen. Gleiche Quelle + gleiche Meldung = eine Zeile mit Zähler.
model Fehlerprotokoll {
  id         String    @id @default(cuid())
  quelle     String    // z. B. "Hintergrundlauf/Aufgaben", "Mailversand", "Rechnungslauf"
  stufe      String    @default("FEHLER") // FEHLER | WARNUNG
  meldung    String
  detail     String?
  anzahl     Int       @default(1)
  zuerstAm   DateTime  @default(now())
  zuletztAm  DateTime  @default(now())
  erledigtAm DateTime?
  /// wann dieser Eintrag zuletzt in einer Tagesmail stand
  gemeldetAm DateTime?

  @@index([zuletztAm(sort: Desc)])
}
