  unterhaltungId String
  nutzerId    String
  rolle       String // user | assistant
  text        String
  quellen     Json?
  erstelltAm  DateTime @default(now())
  @@index([unterhaltungId])
}

model Monatsreport {
  id             String   @id @default(cuid())
  jahr           Int
  monat          Int
  kostenstelleId String?
  inhalt         String
  erstelltAm     DateTime @default(now())
